# ── Required ──────────────────────────────────────────────
# OpenAI API key — powers the RAG chatbot
OPENAI_API_KEY=sk-...

# Your production domain (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ── Optional ──────────────────────────────────────────────
# NODE_ENV is set automatically by Next.js build
# NODE_ENV=production
